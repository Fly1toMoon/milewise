# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/

# Raw crawled / manually saved pages: never committed (see docs/design.md §5.4)
raw/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
terraform.tfvars
backend.hcl
# .terraform.lock.hcl IS committed

# Local env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Per-run eval exports (full answers); only eval/results/latest.md is committed
eval/results/*.jsonl
