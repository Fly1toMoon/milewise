# Copy to .env (gitignored). Never commit real keys.
# Every setting in src/milewise/config.py can be overridden here by its upper-case name
# (CHAT_MODEL, FOLLOW_UP_MODEL, JUDGE_MODEL, ...); the defaults run entirely on Amazon Bedrock.

# AWS (credentials come from `aws login --profile milewise`, not from this file)
AWS_PROFILE=milewise
AWS_REGION=ap-northeast-1

# Owner token for POST /ask (local); in AWS it comes from Secrets Manager
APP_TOKEN=

# Optional: only for openai:* models in A/B runs (make check-openai)
OPENAI_API_KEY=

# Optional: Cloudflare Turnstile secret (make put-turnstile-secret)
TURNSTILE_SECRET=
