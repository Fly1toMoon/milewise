# Copy to .env (gitignored). Never commit real keys.

# OpenAI: use a project-scoped key from the "milewise" project.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_STRONG_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# AWS (credentials come from `aws login --profile milewise`, not from this file)
AWS_PROFILE=milewise
AWS_REGION=ap-northeast-1

# Local docker-compose Postgres
DATABASE_URL=postgresql://milewise:milewise@localhost:5432/milewise

# Bearer token required by POST /ask (local); in AWS it comes from Secrets Manager
APP_TOKEN=
